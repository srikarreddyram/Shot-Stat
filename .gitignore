# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data directories (Heavy DB files and CSVs)
data/

# Environment
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# MacOS
.DS_Store

# Model binaries and run artifacts. The run MANIFEST (runs/*/run.json) is small,
# diffable and worth committing — it records params, metrics, the data hash and
# the git SHA. The .json boosters, .png plots and .csv dumps beside it are not:
# they are large, regenerable, and produce useless binary diffs.
models/*.json
models/*.joblib
models/*.png
!models/best_params_*.json
!models/metadata_*.json
runs/*/*.png
runs/*/*.csv

# Training/ingest console output. Regenerable, and the run manifest already
# records everything durable about a run.
logs/

# Dev-server runtime state (scripts/dev.sh) — process groups and ports
# for the current run. Machine-local and meaningless in a diff.
.dev-runtime/
